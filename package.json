{
  "name": "st-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "st": "node scripts/st-dev.mjs",
    "clean": "node scripts/clean-dist.mjs",
    "build": "node scripts/clean-dist.mjs && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "selfcheck": "node scripts/run-selfchecks.mjs",
    "preview": "vite preview",
    "icons": "node scripts/gen-app-icon.mjs && tauri icon src-tauri/icons/app-icon.png",
    "relay-test": "cargo test --manifest-path src-tauri/Cargo.toml --test relay_e2e -- --nocapture",
    "tauri": "tauri"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "dompurify": "^3.4.16",
    "handlebars": "^4.7.9",
    "highlight.js": "^11.12.0",
    "pinia": "^2.3.0",
    "seedrandom": "^3.0.5",
    "streamdown-vue3": "^0.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/dompurify": "^3.0.5",
    "@types/seedrandom": "^3.0.8",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "unocss": "^66.10.5",
    "vite": "^6.0.5",
    "vue-tsc": "^2.1.10"
  }
}
