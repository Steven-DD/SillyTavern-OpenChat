{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SillyTavern-OpenChat",
  "mainBinaryName": "SillyTavern-OpenChat",
  "version": "0.2.0",
  "identifier": "io.github.stevendd.sillytavernopenchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SillyTavern-OpenChat",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: http://127.0.0.1:*; style-src 'self' 'unsafe-inline' https: http://127.0.0.1:*; img-src 'self' http://127.0.0.1:* http://localhost:1420 data: blob: https:; font-src 'self' data: https: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* http://localhost:1420 https:; object-src 'none'; base-uri 'self'; frame-src http://127.0.0.1:* http://localhost:1420; worker-src 'self' blob:; upgrade-insecure-requests"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "datago",
    "copyright": "AGPL-3.0",
    "shortDescription": "类微信式桌面聊天客户端（自包含 Rust 后端）",
    "longDescription": "内置 Rust 本地 HTTP 后端，数据以 SillyTavern 兼容格式保存，提供类微信的三栏聊天界面。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Steven-DD/SillyTavern-OpenChat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNzczRUZCMTM1REJGMEEKUldRS3YxMFQrejUzOGJMaUZQNm1nR0ZUYzdQRVhvOTZNQnUvN0ZQUGx4UTNiVkxEMjRDU3ppRUQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
