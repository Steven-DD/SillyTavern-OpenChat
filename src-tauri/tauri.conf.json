{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ST Chat",
  "version": "0.1.0",
  "identifier": "io.github.stevendd.stchat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ST Chat",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "datago",
    "copyright": "AGPL-3.0 (依赖 SillyTavern，同协议开源)",
    "shortDescription": "SillyTavern 的微信式桌面客户端",
    "longDescription": "把 SillyTavern 作为本地后端托管，提供类微信的三栏聊天界面。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Steven-DD/SillyTavern-OpenChat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYxNzczRUZCMTM1REJGMEEKUldRS3YxMFQrejUzOGJMaUZQNm1nR0ZUYzdQRVhvOTZNQnUvN0ZQUGx4UTNiVkxEMjRDU3ppRUQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
