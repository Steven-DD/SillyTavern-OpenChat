{
  "id": "git",
  "name": "Git",
  "tier": "optional",
  "kind": "process",
  "description": "仅在安装 SillyTavern 第三方扩展时需要。缺失不影响聊天，因此定为可选插件。",

  "provides": ["vcs"],

  "probe": {
    "commands": ["git"],
    "version_args": ["--version"],
    "version_pattern": "(\\d+\\.\\d+\\.\\d+)",
    "min_version": "2.30.0",
    "search_paths": [
      "%ProgramFiles%\\Git\\cmd\\git.exe",
      "%ProgramFiles(x86)%\\Git\\cmd\\git.exe",
      "%LOCALAPPDATA%\\Programs\\Git\\cmd\\git.exe"
    ]
  },

  "entry": {
    "exec_names": ["git.exe", "git"]
  },

  "install": {
    "archive": "self-extracting",
    "strip_prefix": 0,
    "entry_relpath": "cmd/git.exe",
    "sources": [
      {
        "label": "MinGit（官方便携版）",
        "url": "https://github.com/git-for-windows/git/releases/download/v{version}.windows.1/MinGit-{version}-64-bit.zip",
        "sha256": "PENDING"
      }
    ]
  }
}
